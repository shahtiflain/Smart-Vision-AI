PORT=3000
GEMINI_MODEL=gemini-1.5-pro
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY="your_private_key"
MONGODB_URI="mongodb+srv://your_cluster.mongodb.net/smartvision"

# Rate Limiting
RATE_LIMIT_GUEST_PER_MIN=3
RATE_LIMIT_USER_PER_MIN=10
DAILY_GLOBAL_CAP=1000

# Security
ALLOWED_ORIGINS=https://your-production-domain.com,https://another-domain.com
